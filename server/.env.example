# ── Django ──────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
# DEBUG must be False in any environment reachable by real users — verbose error pages
# leak secrets/stack traces. Only set True for local development.
DEBUG=True
# Comma-separated list of hostnames this server will answer as. REQUIRED (no wildcard
# fallback) once DEBUG=False. On Render, this is your service's *.onrender.com hostname
# (and your own custom domain, if/when you attach one) — e.g. khelomore-server.onrender.com
ALLOWED_HOSTS=*

# ── MongoDB ──────────────────────────────────────
# Your MongoDB Atlas connection string. Make sure Atlas's Network Access allows Render's
# outbound IPs — on Render's free tier these are dynamic, so either add 0.0.0.0/0
# (all IPs) or use Render's static outbound IP add-on and whitelist those specifically.
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=KheloMoreDB
# Only used when running `manage.py test` — routes tests to an isolated database so they
# never touch production data. Not required in the deployed environment itself.
MONGO_DB_NAME_TEST=KheloMoreDB_test

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
# Gamer-app sessions (seconds). Default: 30 days.
JWT_EXP_DELTA_SECONDS=2592000
# cafe-command-center / playhub-command sessions (seconds) — deliberately shorter than
# the gamer app since these control real money/cafe data. Default: 24 hours.
JWT_ADMIN_EXP_DELTA_SECONDS=86400

# ── AES Encryption ───────────────────────────────
# Generate with: python -c "from Crypto.Random import get_random_bytes; import base64; print(base64.b64encode(get_random_bytes(32)).decode())"
ENCRYPTION_KEY=your-32-byte-base64-encoded-key
IV=your-16-byte-base64-encoded-iv

# ── Admin ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# No hardcoded fallback exists — the app refuses to start without this set.
ADMIN_TOKEN=your-random-admin-bootstrap-token

# ── OTP / login lockout tuning (all optional — sensible defaults shown) ──────────
MAX_OTP_ATTEMPTS=5
OTP_EXPIRY_MINUTES=10
# Super admin OTPs expire faster than other roles — the platform's most sensitive login.
SUPER_ADMIN_OTP_EXPIRY_MINUTES=2
OTP_RESEND_COOLDOWN_SECONDS=45
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── CORS ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated list of your real frontend origins (gaming-cafe-connect website,
# cafe-command-center, playhub-command, and the mobile app's web fallback if any).
# REQUIRED (no wildcard fallback) once DEBUG=False — auth cookies are SameSite=None +
# credentialed CORS, so an unrestricted origin list lets any website read authenticated
# responses on a logged-in user's behalf. This same list also gates
# OriginValidationMiddleware (see middleware.py) — get it right or real cross-site writes
# from your own frontends will be rejected too.
# CORS_ALLOWED_ORIGINS=https://your-website.com,https://your-admin-dashboard.com

# ── Google Sign-In (optional — leave blank to disable) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay (platform account — used for subscriptions + as the booking-payment
# fallback when a cafe hasn't connected its own account) ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cloudinary (cafe/tournament photo uploads) ────────────────────────────────────
# WARNING: cafes.py and tournaments.py fall back to a HARDCODED cloud_name/api_key if
# these aren't set — meaning uploads would silently go to whatever Cloudinary account
# those hardcoded values point to unless you override all three here. Always set all
# three explicitly in any real deployment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (OTP delivery — Brevo HTTP API) ──────────────────────────────────────────
# Without these set, OTP emails silently fail to send (logged, not crashed) — login and
# signup will appear to succeed ("OTP sent") but the user never receives a code, so
# nobody can actually complete auth. Must be set before going live.
# NOT raw SMTP: Render silently black-holes outbound SMTP connections (confirmed live —
# smtplib hung forever regardless of any timeout, killing the gunicorn worker on every
# login). Brevo's HTTPS transactional email API sidesteps that entirely.
#   1. Sign up free at brevo.com (300 emails/day, no card required).
#   2. Settings -> Senders, Domains & Dedicated IPs -> add & verify the address you'll
#      send from (they'll email a confirmation link to it).
#   3. Settings -> API Keys -> generate a key -> BREVO_API_KEY.
# EMAIL_SENDER is "Display Name <address@example.com>" — shown as the email's From name.
BREVO_API_KEY=
EMAIL_SENDER=KheloMore Gaming Hub <you@example.com>
